# Copie para .env e preencha. NUNCA versione o .env.
# Gere tokens fortes, ex.: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=
# Opcional: habilita GET /logs (header X-Logs-Token). Deixe vazio para manter desabilitado.
WEBHOOK_LOGS_TOKEN=
# 127.0.0.1 = só local (atrás de proxy reverso). Use 0.0.0.0 apenas com aprovação da TI.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=5000
